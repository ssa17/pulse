<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Pulse</string>
	<key>CFBundleDisplayName</key>
	<string>Pulse</string>
	<key>CFBundleIdentifier</key>
	<string>local.pulse.monitor</string>
	<key>CFBundleExecutable</key>
	<string>Pulse</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleVersion</key>
	<string>1.6</string>
	<key>CFBundleShortVersionString</key>
	<string>1.6</string>
	<key>CFBundleIconFile</key>
	<string>Pulse</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<!-- Sparkle auto-update: EdDSA public key (private key is in the keychain, never committed). -->
	<key>SUPublicEDKey</key>
	<string>yn96rY7JX7sA3H00KKstvHR4DEekZVjZqifBAJy+V5k=</string>
	<!-- Sparkle auto-update: where to fetch the appcast (list of releases). -->
	<key>SUFeedURL</key>
	<string>https://raw.githubusercontent.com/ssa17/pulse/main/releases/appcast.xml</string>
	<!-- Sparkle auto-update: enable the scheduled background checks. Sparkle 2 renamed
	     the 1.x SUAutomaticallyCheckForUpdates key to SUEnableAutomaticChecks —
	     without it SPUUpdater never auto-checks (manual checks still work), so the
	     "hourly" interval below was silently dead in every release. -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<!-- Sparkle auto-update: how often (seconds) to fetch the appcast when no update
	     is pending. Sparkle's default is 24h; hourly so new releases appear within the hour.
	     A user-chosen value (defaults write … SUScheduledCheckInterval) overrides this. -->
	<key>SUScheduledCheckInterval</key>
	<integer>3600</integer>
	<!-- WKWebView refuses http:// URLs (even 127.0.0.1) without this exception. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
