# Build output
dist/

# Generated icon & DMG background (regenerated on build/packaging)
app/Pulse-1024.png
app/dmg-background.png

# Fastlane test report (regenerated on each run)
fastlane/report.xml

# Sparkle update archives (the appcast.xml in releases/ IS committed; zips are not)
releases/*.zip
releases/*.md
releases/old_updates/

# Vendored third-party binaries (fetched by vendor/fetch-sparkle.sh)
vendor/sparkle/

# Secrets — never commit signing keys
secrets/

# Local-only working workspace — task briefs, screenshots, baselines, personal notes
# (may contain the maintainer's machine data; never commit — see AGENTS.md & .work/README.md)
.work/

# macOS
.DS_Store

# Icon cache (regenerated at runtime)
.iconcache/

# Node (if dependencies are ever added)
node_modules/
