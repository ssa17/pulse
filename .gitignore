# Build output
dist/

# Generated icon (regenerated by app/make-icon.mjs on each build)
app/Pulse-1024.png

# Fastlane test report (regenerated on each run)
fastlane/report.xml

# Sparkle update archives (the appcast.xml in releases/ IS committed; zips are not)
releases/*.zip
releases/*.md
releases/old_updates/

# Vendored third-party binaries (fetched by vendor/fetch-sparkle.sh)
vendor/sparkle/

# Secrets — never commit signing keys
secrets/

# Maintainer-only distribution setup notes (the committed distribution-guide.md
# is the streamlined version; this keeps the full one-time-setup walkthrough)
docs/distribution-setup.md

# macOS
.DS_Store

# Icon cache (regenerated at runtime)
.iconcache/

# Node (if dependencies are ever added)
node_modules/

# Task-brief artifacts — kept LOCAL-ONLY by user decision (useful for the maintainer and local
# agents, but not part of the repo): the brief, both screenshots (the dashboard one shows the
# user's own apps), and date-stamped measurement baselines
docs/screenshots/
docs/baseline-*/
docs/prompt-lightweight-responsiveness.md
